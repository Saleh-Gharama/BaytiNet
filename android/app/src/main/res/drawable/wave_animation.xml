<?xml version="1.0" encoding="utf-8"?>
<animation-list xmlns:android="http://schemas.android.com/apk/res/android" android:oneshot="false">
    <!-- Simplest way to "animate" in a widget is a frame animation or an animated vector -->
    <!-- We'll use a series of subtly different wave shapes if we had vectors,
         but for this environment, we'll simulate it with colors/alphas or multiple frames -->
    <item android:drawable="@drawable/wave_frame_1" android:duration="500" />
    <item android:drawable="@drawable/wave_frame_2" android:duration="500" />
    <item android:drawable="@drawable/wave_frame_3" android:duration="500" />
</animation-list>
